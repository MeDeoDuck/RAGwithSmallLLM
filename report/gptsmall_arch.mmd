flowchart BT
  IN["Inputs"]:::io
  EMB["Token Embedding   50,258 × 512"]:::emb
  IN --> EMB

  subgraph BLOCK["Transformer Layer    × 4"]
    direction BT
    N1["RMSNorm"]:::norm
    ATT["Grouped-Query Attention  ·  RoPE<br/>16 q : 4 kv heads   causal + padding mask"]:::attn
    ADD1(("＋")):::add
    N2["RMSNorm"]:::norm
    FFN["SwiGLU Feed Forward   512 → 2048 → 512"]:::ffn
    ADD2(("＋")):::add

    N1 --> ATT --> ADD1
    ADD1 --> N2 --> FFN --> ADD2
  end

  EMB --> N1
  EMB -. "residual" .-> ADD1
  ADD1 -. "residual" .-> ADD2

  NF["RMSNorm"]:::norm
  LM["Linear · LM Head   512 → 50,258"]:::lin
  SM["Softmax"]:::soft
  OUT["Next-token Probabilities"]:::io

  ADD2 --> NF --> LM --> SM --> OUT

